{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug FastAPI (Backend)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "backend.main:app",
                "--reload",
                "--port",
                "8000"
            ],
            "jinja": true,
            "justMyCode": false
        },
        {
            "name": "Debug Streamlit (Frontend)",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/frontend/app.py",
                "--server.port",
                "8501",
                "--server.headless",
                "true"
            ],
            "justMyCode": false
        }
    ],
    "compounds": [
        {
            "name": "Launch LedgerLens (Full Stack)",
            "configurations": [
                "Debug FastAPI (Backend)",
                "Debug Streamlit (Frontend)"
            ]
        }
    ]
}